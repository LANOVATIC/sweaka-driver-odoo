<?xml version="1.0" encoding="utf-8"?>
<!-- T9.6.12a: back-office review of driver documents (Inventory › Sweaka Driver). Written with list views (Odoo 18+);
     build.py renames them for Odoo 17. -->
<odoo>
    <!-- Drivers + handover code (given face to face; the app asks for it to validate a van load / close the day) -->
    <record id="view_sweaka_drivers_list" model="ir.ui.view">
        <field name="name">sweaka.drivers.list</field>
        <field name="model">res.users</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="name"/>
                <field name="login"/>
                <field name="sweaka_van_location_id"/>
                <field name="sweaka_handover_code"/>
            </list>
        </field>
    </record>
    <record id="action_sweaka_drivers" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sweaka_drivers_list"/>
        <field name="domain">[("sweaka_driver", "=", True)]</field>
        <field name="context">{"create": False}</field>
    </record>

    <!-- Stock losses: validate = scrap from the driver's van -->
    <record id="view_sweaka_stock_loss_list" model="ir.ui.view">
        <field name="name">sweaka.stock.loss.list</field>
        <field name="model">sweaka.stock.loss</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="reason"/>
                <field name="declared_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_sweaka_stock_loss_form" model="ir.ui.view">
        <field name="name">sweaka.stock.loss.form</field>
        <field name="model">sweaka.stock.loss</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_validate" type="object" string="Validate (scrap from van)" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="driver_id"/>
                            <field name="reason" readonly="1"/>
                            <field name="declared_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="validated_at" invisible="not validated_at"/>
                            <field name="rejected_at" invisible="not rejected_at"/>
                            <field name="reject_reason" readonly="state != 'pending'"/>
                            <field name="latitude" readonly="1" invisible="not latitude"/>
                            <field name="longitude" readonly="1" invisible="not longitude"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="qty"/>
                        </list>
                    </field>
                    <field name="note" readonly="1" placeholder="Driver note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sweaka_stock_loss_search" model="ir.ui.view">
        <field name="name">sweaka.stock.loss.search</field>
        <field name="model">sweaka.stock.loss</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <filter name="pending" string="To review" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>
    <record id="action_sweaka_stock_loss" model="ir.actions.act_window">
        <field name="name">Stock losses</field>
        <field name="res_model">sweaka.stock.loss</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_pending": 1}</field>
    </record>

    <!-- Cash handovers: validated amounts leave the driver's cash -->
    <record id="view_sweaka_cash_handover_list" model="ir.ui.view">
        <field name="name">sweaka.cash.handover.list</field>
        <field name="model">sweaka.cash.handover</field>
        <field name="arch" type="xml">
            <list create="0" decoration-info="state == 'pending'" decoration-muted="state == 'rejected'">
                <field name="name"/>
                <field name="driver_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="declared_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_sweaka_cash_handover_form" model="ir.ui.view">
        <field name="name">sweaka.cash.handover.form</field>
        <field name="model">sweaka.cash.handover</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_validate" type="object" string="Validate (cash received)" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Reject" invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="driver_id"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="declared_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="validated_at" invisible="not validated_at"/>
                            <field name="rejected_at" invisible="not rejected_at"/>
                            <field name="reject_reason" readonly="state != 'pending'"/>
                            <field name="latitude" readonly="1" invisible="not latitude"/>
                            <field name="longitude" readonly="1" invisible="not longitude"/>
                        </group>
                    </group>
                    <field name="note" readonly="1" placeholder="Driver note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_sweaka_cash_handover_search" model="ir.ui.view">
        <field name="name">sweaka.cash.handover.search</field>
        <field name="model">sweaka.cash.handover</field>
        <field name="arch" type="xml">
            <search>
                <field name="driver_id"/>
                <filter name="pending" string="To review" domain="[('state', '=', 'pending')]"/>
            </search>
        </field>
    </record>
    <record id="action_sweaka_cash_handover" model="ir.actions.act_window">
        <field name="name">Cash handovers</field>
        <field name="res_model">sweaka.cash.handover</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_pending": 1}</field>
    </record>

    <!-- Day closes: read-only snapshot of the van at end of day -->
    <record id="view_sweaka_day_close_list" model="ir.ui.view">
        <field name="name">sweaka.day.close.list</field>
        <field name="model">sweaka.day.close</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0">
                <field name="create_date" string="Closed at"/>
                <field name="driver_id"/>
                <field name="name" string="Number"/>
            </list>
        </field>
    </record>
    <record id="view_sweaka_day_close_form" model="ir.ui.view">
        <field name="name">sweaka.day.close.form</field>
        <field name="model">sweaka.day.close</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <field name="driver_id"/>
                        <field name="name" string="Number"/>
                        <field name="create_date" string="Closed at"/>
                        <field name="note"/>
                        <field name="lines_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sweaka_day_close" model="ir.actions.act_window">
        <field name="name">Day closes</field>
        <field name="res_model">sweaka.day.close</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- GPS points (retention: system parameter sweaka_driver.gps_retention_days) -->
    <record id="view_sweaka_driver_location_list" model="ir.ui.view">
        <field name="name">sweaka.driver.location.list</field>
        <field name="model">sweaka.driver.location</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" default_order="captured_at desc">
                <field name="captured_at"/>
                <field name="driver_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="accuracy_m"/>
                <field name="speed_kmh"/>
            </list>
        </field>
    </record>
    <record id="action_sweaka_driver_location" model="ir.actions.act_window">
        <field name="name">GPS points</field>
        <field name="res_model">sweaka.driver.location</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_sweaka_driver_root" name="Sweaka Driver" parent="stock.menu_stock_root" sequence="90"/>
    <menuitem id="menu_sweaka_drivers" name="Drivers" parent="menu_sweaka_driver_root" action="action_sweaka_drivers"
              sequence="5" groups="stock.group_stock_manager,account.group_account_manager"/>
    <menuitem id="menu_sweaka_stock_loss" name="Stock losses" parent="menu_sweaka_driver_root"
              action="action_sweaka_stock_loss" sequence="10" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sweaka_cash_handover" name="Cash handovers" parent="menu_sweaka_driver_root"
              action="action_sweaka_cash_handover" sequence="20" groups="account.group_account_manager"/>
    <menuitem id="menu_sweaka_day_close" name="Day closes" parent="menu_sweaka_driver_root"
              action="action_sweaka_day_close" sequence="30" groups="stock.group_stock_manager"/>
    <menuitem id="menu_sweaka_driver_location" name="GPS points" parent="menu_sweaka_driver_root"
              action="action_sweaka_driver_location" sequence="40" groups="stock.group_stock_manager"/>
</odoo>
